<!doctype html>
<html lang="{{ 'zh-CN' if language == 'zh' else 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>藏片阁</title>
  <script>
    try {
      var savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
    } catch (e) {}
    window.__shelfLoadErrors = [];
  </script>
  <link rel="stylesheet" href="{{ site_dir }}/tokens.css">
  <link rel="stylesheet" href="{{ site_dir }}/app.css">
  <script src="{{ site_dir }}/i18n.js" onerror="window.__shelfLoadErrors.push('i18n.js')"></script>
{%- for name in data_files %}
  <script src="{{ site_dir }}/data/{{ name }}" onerror="window.__shelfLoadErrors.push('{{ name }}')"></script>
{%- endfor %}
  <script src="{{ site_dir }}/shelf-core.js" onerror="window.__shelfLoadErrors.push('shelf-core.js')"></script>
  <script src="{{ site_dir }}/ripple.js"></script>
</head>
<body data-version="{{ version }}" data-built-at="{{ built_at }}" data-language="{{ language }}">
  <noscript>
    <div class="noscript">藏片阁需要启用 JavaScript 才能浏览。Hidden Shelf needs JavaScript enabled.</div>
  </noscript>
  <div id="app" class="app" aria-busy="true"></div>
  <script src="{{ site_dir }}/app.js" onerror="window.__shelfLoadErrors.push('app.js')"></script>
</body>
</html>
