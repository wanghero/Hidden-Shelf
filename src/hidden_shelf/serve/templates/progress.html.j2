<!doctype html>
<html lang="zh-CN" data-steps="{{ steps | join(',') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>藏片阁 · 运行</title>
  <script>
    try {
      var savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
    } catch (e) {}
  </script>
  <link rel="stylesheet" href="/static/tokens.css">
  <link rel="stylesheet" href="/static/progress.css">
</head>
<body data-version="{{ version }}">
  <div id="app" class="shell"></div>
  <script>window.__shelfServe = {version: {{ version | tojson }}, steps: {{ steps | tojson }}, stepLabels: {{ step_labels | tojson }}, changelog: {{ changelog | tojson }}};</script>
  <script src="/static/i18n.js"></script>
  <script src="/static/progress-core.js"></script>
  <script src="/static/ripple.js"></script>
  <script src="/static/progress.js"></script>
</body>
</html>
